# Copy to deploy/.env, or run `node deploy/setup.mjs` to fill it in for you
# (it generates the secrets and never overwrites a value you set).
# Every setting is an environment variable.

# Where readers reach the site (default http://localhost:3000). Used for the OIDC
# callback, the GitHub webhook URL and secure cookies.
PUBLIC_URL=

# At least 32 random characters: openssl rand -hex 32
SESSION_SECRET=

# Postgres password used by docker-compose.yml (default: opend). Set it before the
# first start: the database volume keeps the password it was created with.
POSTGRES_PASSWORD=

# GitHub webhook: the secret you set on the repository or GitHub App webhook.
GITHUB_WEBHOOK_SECRET=

# GitHub App, for private repositories and commit statuses (optional).
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_API_URL=https://github.example.com/api/v3   # GitHub Enterprise Server
# GITHUB_WEB_URL=https://github.example.com          # read by deploy/setup.mjs only

# Reader sign-in through your identity provider (OIDC).
# Register the redirect URI ${PUBLIC_URL}/auth/callback with the provider.
# OIDC_ISSUER=https://login.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# Blob storage for built images and theme files. By default a local folder
# (BLOB_DIR, /data/blobs in the image), which only works when the app and the
# worker share a volume on one host. Set S3_BUCKET to use any S3-compatible
# bucket instead; S3_ENDPOINT, S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY are then
# required too. Set the same values on the app and the worker.
# BLOB_DIR=/data/blobs
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto            # default auto
# S3_FORCE_PATH_STYLE=1     # for MinIO and other services without virtual-hosted buckets
# S3_PREFIX=opend/          # optional key prefix to share a bucket
#
# On Railway, add a Bucket and map its variables with reference variables on
# both the web and worker services (virtual-hosted style, so leave
# S3_FORCE_PATH_STYLE unset):
# S3_ENDPOINT=${{Bucket.ENDPOINT}}
# S3_BUCKET=${{Bucket.BUCKET}}
# S3_ACCESS_KEY_ID=${{Bucket.ACCESS_KEY_ID}}
# S3_SECRET_ACCESS_KEY=${{Bucket.SECRET_ACCESS_KEY}}
# S3_REGION=${{Bucket.REGION}}

# Admin API bearer token, at least 24 characters (optional; no admin API without it).
OPEND_ADMIN_TOKEN=

# Local evaluation only: sign in as any seeded reader without an identity provider.
# Requires NODE_ENV=development; the server refuses to start otherwise.
# NODE_ENV=development
# OPEND_DEV_LOGIN=1

# Embedded help in your own web apps (optional; both must be set).
# The secret your app's backend uses to sign embed tokens: openssl rand -hex 32
# OPEND_EMBED_SECRET=
# Origins allowed to embed the help panel, comma-separated.
# OPEND_EMBED_ORIGINS=https://app.example.com

# When more than one docs repository is registered, the one the site serves.
# OPEND_SITE_REPO=acme/docs

# PDF publications are printed with the Chromium in the image (OPEND_CHROMIUM_PATH).
# Set to 1 to run Chromium with its own sandbox, if your runtime allows the
# namespaces it needs (for example a custom seccomp profile).
# OPEND_CHROMIUM_SANDBOX=1

# Polling mode, when GitHub's webhooks cannot reach this server: the worker
# checks each repo's release refs every N seconds (0 or unset: off; minimum 10).
# POLL_INTERVAL_SECONDS=60

# Entitlement sync from billing or a CRM (all optional).
# Secret for signed POST /webhooks/entitlements calls, at least 32 characters.
# ENTITLEMENT_WEBHOOK_SECRET=
# Export that `opend-server reconcile` fetches nightly, and its bearer token.
# ENTITLEMENT_SOURCE_URL=https://crm.example.com/opend/export.json
# ENTITLEMENT_SOURCE_TOKEN=
# merge: only create and update. replace: also remove orgs and readers the export omits.
# ENTITLEMENT_SYNC_MODE=merge

# ---- Web editor (optional; `docker compose --profile editor up -d`) ----------
# The editor runs on its own host, never the docs site's, with its own accounts
# and cookie. It commits through the GitHub App above (GITHUB_APP_ID and
# GITHUB_APP_PRIVATE_KEY are required), which needs Contents and Pull requests
# read and write, and Administration read to show branch protection.
# EDITOR_PUBLIC_URL=http://localhost:3001
# EDITOR_SESSION_SECRET=   # 32+ characters, different from SESSION_SECRET
# Developers sign in with GitHub (register ${EDITOR_PUBLIC_URL}/auth/github/callback).
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# Other authors sign in with company OIDC (register ${EDITOR_PUBLIC_URL}/auth/oidc/callback)
# and must be added first: opend-server editor add-user someone@example.com --name "Someone"
# EDITOR_OIDC_ISSUER=https://login.example.com
# EDITOR_OIDC_CLIENT_ID=
# EDITOR_OIDC_CLIENT_SECRET=
# Which registered repo to edit (default: OPEND_SITE_REPO, or the only one) and its base branch.
# EDITOR_REPO=acme/docs
# EDITOR_BASE_BRANCH=main
