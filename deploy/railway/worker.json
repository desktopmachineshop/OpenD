{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/Dockerfile",
    "watchPatterns": [
      "packages/**",
      "deploy/Dockerfile",
      "deploy/railway/**",
      "package.json",
      "pnpm-lock.yaml"
    ]
  },
  "deploy": {
    "startCommand": "node dist/bin.js worker",
    "restartPolicyType": "ALWAYS"
  }
}
